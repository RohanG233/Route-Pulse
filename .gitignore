# =============================================================================
# RoutePulse .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# pytest
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ---------------------------------------------------------------------------
# RoutePulse — generated dataset files
# The generator is deterministic (seed 42); regenerate with:
#   cd backend && python -m app.data.generate_dataset
# ---------------------------------------------------------------------------
backend/app/data/generated/*.csv
backend/app/data/generated/*.json

# Test artefacts (also regeneratable)
backend/test_results.txt
backend/test_output.txt
backend/test_err.txt

# ---------------------------------------------------------------------------
# Node / Frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Vite / TypeScript build outputs
frontend/dist/
frontend/.vite/
frontend/tsconfig*.tsbuildinfo

# ---------------------------------------------------------------------------
# Environment files
# .env.example files ARE committed (they document required variables).
# Actual .env files with secrets are NOT committed.
# ---------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
backend/.env
frontend/.env

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
.dockerignore      # intentionally listed so it doesn't block itself

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
