# RoutePulse backend environment variables
# Copy this file to .env and fill in values for your environment.
# .env is git-ignored; this file is committed as documentation.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Host to bind uvicorn on (0.0.0.0 exposes on all interfaces)
HOST=0.0.0.0

# Port uvicorn listens on
PORT=8000

# Number of uvicorn worker processes (production: set to CPU count)
WORKERS=1

# Logging level: debug | info | warning | error | critical
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for the browser.
# Add your production frontend URL here.
# Example: https://routepulse.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ---------------------------------------------------------------------------
# Dataset
# ---------------------------------------------------------------------------
# Random seed used by the synthetic dataset generator.
# Changing this produces different (but still valid) data.
RANDOM_SEED=42

# ---------------------------------------------------------------------------
# Planning
# ---------------------------------------------------------------------------
# Default objective weights (can also be overridden per POST /api/plan request)
WEIGHT_WAITING_TIME=1.0
WEIGHT_UNMET_PASSENGERS=5.0
WEIGHT_MISSED_CONNECTIONS=10.0
