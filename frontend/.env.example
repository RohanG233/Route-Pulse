# RoutePulse frontend environment variables
# Copy this file to .env (for local dev) or .env.production (for prod builds).
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# URL of the RoutePulse backend API.
# Local development default:
VITE_API_URL=http://localhost:8000/api

# Production example (replace with your actual deployment URL):
# VITE_API_URL=https://api.routepulse.example.com/api
